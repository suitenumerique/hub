#!/usr/bin/env bash
# Prints the one-time command that makes this machine trust the certificate
# authority generated by the Tchap HTTPS proxy (Caddy, in data/caddy/).
# Docker cannot change the host trust store, so the command runs on the host.
set -euo pipefail

ROOT_CA="${1:-data/caddy/caddy/pki/authorities/local/root.crt}"

if [[ ! -f "$ROOT_CA" ]]; then
  echo "No certificate authority yet: run 'make run-tchap' first." >&2
  exit 1
fi
ROOT_CA="$(cd "$(dirname "$ROOT_CA")" && pwd)/$(basename "$ROOT_CA")"

echo "Certificate authority: $ROOT_CA"
echo
if grep -qi microsoft /proc/version 2>/dev/null; then
  cat <<EOF
Windows (WSL): the browser runs on Windows. In an administrator PowerShell:
  certutil -addstore -f ROOT "$(wslpath -w "$ROOT_CA")"
Or open that file from the Windows Explorer, then Install Certificate >
Local Machine > "Trusted Root Certification Authorities".
EOF
elif [[ "$(uname -s)" == "Darwin" ]]; then
  cat <<EOF
macOS (asks for your password):
  security add-trusted-cert -r trustRoot -k ~/Library/Keychains/login.keychain-db "$ROOT_CA"
Or double-click the file, then set it to "Always Trust" in Keychain Access.
EOF
else
  cat <<EOF
Linux (system store, then Chrome through NSS; certutil is in libnss3-tools):
  sudo cp "$ROOT_CA" /usr/local/share/ca-certificates/hub-tchap-dev.crt
  sudo update-ca-certificates
  certutil -d "sql:\$HOME/.pki/nssdb" -A -t "C,," -n "Hub Tchap dev" -i "$ROOT_CA"
Firefox: Settings > Privacy & Security > View Certificates > Authorities > Import.
EOF
fi
cat <<EOF

Firefox on macOS or Windows: set security.enterprise_roots.enabled to true in
about:config so it uses the system store. Safari only: add
"127.0.0.1 hub.localhost" to /etc/hosts.
Then open https://hub.localhost:9814.
EOF
