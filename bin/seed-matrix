#!/usr/bin/env python3
"""Dev-only deterministic seed for the local Matrix stack.

Run with `make seed-matrix` after `make run-matrix`. Use
`make seed-matrix-unread` to append a realistic main-timeline unread batch.

The seed is intentionally small for this PR:
  - provision Matrix users linked to existing Keycloak users;
  - create one direct conversation and one multi-user conversation;
  - add a few plaintext messages and one thread in the group.

Idempotency is alias-based: each room has a fixed alias, so a later run finds
the room and does not post the base transcript again. Unread demo batches are
deliberately appended on every run.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Iterator
from typing import Any

KEYCLOAK = "http://localhost:9803"
HOMESERVER = "http://localhost:9808"
SERVER_NAME = "localhost"
HUB_USER_ID = f"@hub:{SERVER_NAME}"

MAS_CONTAINER = "hub-mas-1"
MAS_CONFIG = "/config/config.yaml"
# Keycloak upstream provider id in docker/matrix/mas/config.yaml.
PROVIDER_ID = "0XZP24DYZ8BJXR093M5TH4PKB9"

LINKED_USERS = [
    ("hub", "Hub"),
    ("user-e2e-chromium", "E2E Chromium"),
    ("user-e2e-firefox", "E2E Firefox"),
    ("user-e2e-webkit", "E2E WebKit"),
]

DIRECT_ALIAS_LOCALPART = "hub-seed-webkit"
DIRECT_MESSAGES = [
    ("hub", "Local Matrix direct conversation seeded from Hub."),
    ("user-e2e-webkit", "Hello from the WebKit account."),
]

GROUP_ALIAS_LOCALPART = "hub-seed-group"
GROUP_NAME = "Local Matrix seed group"
GROUP_MESSAGES = [
    ("hub", "Welcome to the local Matrix group."),
    ("user-e2e-chromium", "Chromium can read this room too."),
    ("user-e2e-webkit", "WebKit is also present."),
]

THREAD_ROOT_INDEX = 0
THREAD_REPLIES = [
    ("user-e2e-webkit", "First seeded reply in the Matrix thread."),
    ("user-e2e-chromium", "Second seeded reply, unread after the baseline receipt."),
]

UNREAD_DEMO_MESSAGE_COUNT = 60
UNREAD_DEMO_AUTHOR_BLOCKS = [
    ("user-e2e-chromium", 2),
    ("user-e2e-webkit", 2),
    ("user-e2e-chromium", 4),
    ("user-e2e-webkit", 4),
]
UNREAD_DEMO_EXCHANGES = [
    (
        "J’ai relu la note de cadrage et relevé les décisions encore ouvertes.",
        "Merci, je vérifie la dernière version et les responsables associés.",
    ),
    (
        "Le calendrier reste réaliste si la validation arrive cette semaine.",
        "Je relance l’équipe concernée et je mets à jour le tableau de suivi.",
    ),
    (
        "Le support du pilote doit garder un canal d’escalade clairement identifié.",
        "D’accord, je confirme la permanence et les contacts avant le comité.",
    ),
    (
        "Les indicateurs d’adoption et de délai de traitement sont prêts.",
        "Je les ajoute à la synthèse avec une courte note sur les risques.",
    ),
    (
        "Les estimations restent dans l’enveloppe avec une marge pour les imprévus.",
        "Parfait, je demande une validation écrite avant l’envoi aux équipes.",
    ),
    (
        "Le second site a de meilleurs résultats grâce à sa préparation en amont.",
        "Je récupère leur méthode pour l’intégrer aux recommandations finales.",
    ),
]


def unread_demo_messages() -> list[tuple[str, str]]:
    """Build the required 2/2/4/4 author blocks up to 30 messages each."""
    messages: list[tuple[str, str]] = []
    cycle = 1
    while len(messages) < UNREAD_DEMO_MESSAGE_COUNT:
        for author, block_size in UNREAD_DEMO_AUTHOR_BLOCKS:
            author_index = 0 if author == "user-e2e-chromium" else 1
            for _ in range(block_size):
                index = len(messages)
                exchange = UNREAD_DEMO_EXCHANGES[
                    (index // 2) % len(UNREAD_DEMO_EXCHANGES)
                ]
                messages.append(
                    (author, f"{exchange[author_index]} Passage {cycle}.")
                )
            if len(messages) == UNREAD_DEMO_MESSAGE_COUNT:
                break
        cycle += 1
    return messages


def fail(message: str) -> None:
    print(f"seed-matrix: {message}", file=sys.stderr)
    sys.exit(1)


def http_json(
    method: str,
    url: str,
    token: str = "",
    body: dict[str, Any] | None = None,
) -> dict[str, Any]:
    data = json.dumps(body).encode() if body is not None else None
    attempts = 8

    for attempt in range(attempts):
        request = urllib.request.Request(url, data=data, method=method)
        if token:
            request.add_header("Authorization", f"Bearer {token}")
        if data is not None:
            request.add_header("Content-Type", "application/json")

        try:
            with urllib.request.urlopen(request) as response:
                payload = response.read()
                return json.loads(payload or "{}")
        except urllib.error.HTTPError as error:
            if error.code != 429 or attempt == attempts - 1:
                raise

            retry_ms = 1000
            try:
                retry_ms = int(
                    json.loads(error.read() or "{}").get("retry_after_ms", 1000)
                )
            except (ValueError, json.JSONDecodeError):
                pass
            time.sleep(min(retry_ms / 1000 + 0.2, 5))

    raise RuntimeError("http_json exhausted retries")


def keycloak_admin_token() -> str:
    url = f"{KEYCLOAK}/realms/master/protocol/openid-connect/token"
    data = urllib.parse.urlencode(
        {
            "client_id": "admin-cli",
            "username": "admin",
            "password": "admin",
            "grant_type": "password",
        }
    ).encode()

    try:
        with urllib.request.urlopen(url, data=data) as response:
            return json.loads(response.read())["access_token"]
    except urllib.error.URLError as error:
        fail(f"cannot reach Keycloak at {KEYCLOAK} ({error}). Is `make run-matrix` up?")


def keycloak_sub(admin_token: str, username: str) -> str:
    query = urllib.parse.urlencode({"username": username, "exact": "true"})
    users = http_json(
        "GET",
        f"{KEYCLOAK}/admin/realms/hub/users?{query}",
        token=admin_token,
    )
    if not users:
        fail(f"no Keycloak user '{username}' in realm hub.")
    return users[0]["id"]


def mas_cli(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            "docker",
            "exec",
            MAS_CONTAINER,
            "mas-cli",
            "manage",
            "--config",
            MAS_CONFIG,
            *args,
        ],
        capture_output=True,
        text=True,
        check=False,
    )


def try_issue_token(username: str) -> str | None:
    issued = mas_cli("issue-compatibility-token", username)
    if issued.returncode != 0:
        return None

    marker = "Compatibility token issued: "
    for line in (issued.stdout + issued.stderr).splitlines():
        if marker in line:
            return line.split(marker, 1)[1].split()[0]
    return None


def issue_token(username: str) -> str:
    token = try_issue_token(username)
    if token:
        return token

    fail(f"issue-compatibility-token failed for '{username}'.")


def provision_linked_user(admin_token: str, username: str, display_name: str) -> str:
    sub = keycloak_sub(admin_token, username)
    registered = mas_cli(
        "register-user",
        "--yes",
        "--display-name",
        display_name,
        "--upstream-provider-mapping",
        f"{PROVIDER_ID}:{sub}",
        username,
    )
    output = registered.stdout + registered.stderr
    if registered.returncode != 0 and "already exists" not in output.lower():
        # MAS releases do not use a stable "already exists" error. Confirm the
        # account directly before treating a different diagnostic as fatal.
        existing_token = try_issue_token(username)
        if existing_token:
            return existing_token
        fail(f"register-user failed for '{username}': {output.strip()}")
    return issue_token(username)


def existing_room_id(token: str, alias: str) -> str | None:
    quoted = urllib.parse.quote(alias)
    try:
        return http_json(
            "GET",
            f"{HOMESERVER}/_matrix/client/v3/directory/room/{quoted}",
            token=token,
        ).get("room_id")
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise


def create_room(
    token: str,
    alias_localpart: str,
    name: str,
    invited_localparts: list[str],
    is_direct: bool = False,
) -> str:
    body: dict[str, Any] = {
        "room_alias_name": alias_localpart,
        "preset": "private_chat",
        "visibility": "private",
        "is_direct": is_direct,
        "invite": [f"@{localpart}:{SERVER_NAME}" for localpart in invited_localparts],
    }
    if name:
        body["name"] = name
    return http_json(
        "POST",
        f"{HOMESERVER}/_matrix/client/v3/createRoom",
        token=token,
        body=body,
    )["room_id"]


def join_room(token: str, room_id: str) -> None:
    http_json(
        "POST",
        f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/join",
        token=token,
    )


def invite_user(token: str, room_id: str, localpart: str) -> None:
    http_json(
        "POST",
        f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/invite",
        token=token,
        body={"user_id": f"@{localpart}:{SERVER_NAME}"},
    )


def room_membership(token: str, room_id: str, localpart: str) -> str | None:
    user_id = urllib.parse.quote(f"@{localpart}:{SERVER_NAME}", safe="")
    encoded_room_id = urllib.parse.quote(room_id, safe="")
    try:
        event = http_json(
            "GET",
            (
                f"{HOMESERVER}/_matrix/client/v3/rooms/{encoded_room_id}/state/"
                f"m.room.member/{user_id}"
            ),
            token=token,
        )
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise
    membership = event.get("membership")
    return membership if isinstance(membership, str) else None


def ensure_room_participant(
    tokens: dict[str, str], owner: str, localpart: str, room_id: str
) -> None:
    membership = room_membership(tokens[owner], room_id, localpart)
    if membership not in {"invite", "join"}:
        invite_user(tokens[owner], room_id, localpart)
    join_room(tokens[localpart], room_id)


def send_message(token: str, room_id: str, body: str, txn_id: str) -> str:
    return http_json(
        "PUT",
        f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/send/m.room.message/{txn_id}",
        token=token,
        body={"msgtype": "m.text", "body": body},
    )["event_id"]


def send_thread_reply(
    token: str, room_id: str, root_id: str, body: str, txn_id: str
) -> str:
    return http_json(
        "PUT",
        f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/send/m.room.message/{txn_id}",
        token=token,
        body={
            "msgtype": "m.text",
            "body": body,
            "m.relates_to": {
                "rel_type": "m.thread",
                "event_id": root_id,
                "m.in_reply_to": {"event_id": root_id},
                "is_falling_back": True,
            },
        },
    )["event_id"]


def send_thread_receipt(
    token: str, room_id: str, root_id: str, event_id: str
) -> None:
    http_json(
        "POST",
        f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/receipt/m.read/{event_id}",
        token=token,
        body={"thread_id": root_id},
    )


def room_message_events(
    token: str,
    room_id: str,
) -> Iterator[dict[str, Any]]:
    """Read the full room history backwards, one Matrix page at a time."""
    from_token: str | None = None

    while True:
        query: dict[str, str | int] = {"dir": "b", "limit": 100}
        if from_token:
            query["from"] = from_token
        page = http_json(
            "GET",
            (
                f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/messages?"
                f"{urllib.parse.urlencode(query)}"
            ),
            token=token,
        )
        chunk = page.get("chunk", [])
        if not isinstance(chunk, list):
            return
        yield from chunk

        next_token = page.get("end")
        if not chunk or not next_token or next_token == from_token:
            return
        from_token = next_token


def is_main_timeline_message(event: dict[str, Any]) -> bool:
    """Match the frontend's visible main-timeline message boundary."""
    content = event.get("content", {})
    relation_type = content.get("m.relates_to", {}).get("rel_type")
    return event.get("type") == "m.room.message" and relation_type not in {
        "m.thread",
        "m.replace",
    }


def find_message_id_by_body(token: str, room_id: str, body: str) -> str | None:
    for event in room_message_events(token, room_id):
        content = event.get("content", {})
        if is_main_timeline_message(event) and content.get("body") == body:
            return event.get("event_id")
    return None


def latest_main_message_id(token: str, room_id: str) -> str | None:
    for event in room_message_events(token, room_id):
        if is_main_timeline_message(event):
            return event.get("event_id")
    return None


def fully_read_event_id(token: str, room_id: str) -> str | None:
    """Return Hub's current fully-read marker when one is stored."""
    user_id = urllib.parse.quote(HUB_USER_ID, safe="")
    encoded_room_id = urllib.parse.quote(room_id, safe="")
    try:
        account_data = http_json(
            "GET",
            (
                f"{HOMESERVER}/_matrix/client/v3/user/{user_id}/rooms/"
                f"{encoded_room_id}/account_data/m.fully_read"
            ),
            token=token,
        )
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise

    event_id = account_data.get("event_id")
    return event_id if isinstance(event_id, str) else None


def main_read_receipt_event_id(token: str, room_id: str) -> str | None:
    """Return Hub's newest public/private receipt for the main timeline."""
    sync = http_json(
        "GET",
        f"{HOMESERVER}/_matrix/client/v3/sync?timeout=0",
        token=token,
    )
    ephemeral = (
        sync.get("rooms", {})
        .get("join", {})
        .get(room_id, {})
        .get("ephemeral", {})
        .get("events", [])
    )
    receipts: list[tuple[int, str]] = []
    for event in ephemeral:
        if event.get("type") != "m.receipt":
            continue
        for event_id, receipt_types in event.get("content", {}).items():
            for receipt_type in ("m.read", "m.read.private"):
                data = receipt_types.get(receipt_type, {}).get(HUB_USER_ID)
                if not isinstance(data, dict):
                    continue
                if data.get("thread_id") not in {None, "main"}:
                    continue
                receipts.append((int(data.get("ts", 0)), event_id))
    return max(receipts, default=(0, None))[1]


def persisted_main_boundary_id(token: str, room_id: str) -> str | None:
    """Resolve the furthest stored fully-read marker or main receipt."""
    candidates = {
        event_id
        for event_id in (
            fully_read_event_id(token, room_id),
            main_read_receipt_event_id(token, room_id),
        )
        if event_id
    }
    if not candidates:
        return None
    for event in room_message_events(token, room_id):
        event_id = event.get("event_id")
        if event_id in candidates:
            return event_id
    # An inaccessible marker must be preserved rather than silently advanced.
    return next(iter(candidates))


def should_preserve_main_boundary(
    token: str,
    room_id: str,
    boundary_id: str,
) -> bool:
    """Protect an existing foreign backlog or an unavailable boundary."""
    for event in room_message_events(token, room_id):
        if event.get("event_id") == boundary_id:
            return False
        if (
            is_main_timeline_message(event)
            and event.get("sender") != HUB_USER_ID
        ):
            return True

    # A purged or inaccessible marker must never make the command skip unread
    # messages by silently moving the boundary to the latest event.
    return True


def set_main_read_boundary(token: str, room_id: str, event_id: str) -> None:
    """Advance Hub's main boundary without changing any thread receipt."""
    http_json(
        "POST",
        f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/read_markers",
        token=token,
        body={"m.fully_read": event_id},
    )
    http_json(
        "POST",
        f"{HOMESERVER}/_matrix/client/v3/rooms/{room_id}/receipt/m.read/{event_id}",
        token=token,
        body={"thread_id": "main"},
    )


def prepare_main_read_boundary(token: str, room_id: str) -> None:
    """Preserve a known main-timeline backlog, or initialize a fresh room."""
    boundary_id = persisted_main_boundary_id(token, room_id)
    if boundary_id and should_preserve_main_boundary(token, room_id, boundary_id):
        print(
            "seed-matrix: existing Hub main-timeline unread boundary preserved; "
            "thread receipts are unchanged."
        )
        return

    if not boundary_id:
        print(
            "seed-matrix: no main read marker found; initializing the demo "
            "boundary at the current live end."
        )

    boundary_id = latest_main_message_id(token, room_id)
    if not boundary_id:
        fail("could not find a main-timeline event for the Hub read boundary")
    set_main_read_boundary(token, room_id, boundary_id)
    print(
        "seed-matrix: Hub main timeline marked read before the demo batch; "
        "thread receipts are unchanged."
    )


def seed_unread_demo(tokens: dict[str, str], room_id: str) -> None:
    messages = unread_demo_messages()
    chromium = sum(
        author == "user-e2e-chromium" for author, _ in messages
    )
    webkit = sum(author == "user-e2e-webkit" for author, _ in messages)
    expected_per_author = UNREAD_DEMO_MESSAGE_COUNT // 2
    if (
        len(messages) != UNREAD_DEMO_MESSAGE_COUNT
        or chromium != expected_per_author
        or webkit != expected_per_author
    ):
        fail(
            "unread demo must contain exactly "
            f"{expected_per_author} Chromium and {expected_per_author} WebKit messages"
        )

    prepare_main_read_boundary(tokens["hub"], room_id)
    print(
        "seed-matrix: keep the Hub conversation closed or away from its bottom "
        "until all messages are sent."
    )
    run_id = time.time_ns()
    for index, (author, body) in enumerate(messages, start=1):
        send_message(
            tokens[author],
            room_id,
            f"[{index}/{UNREAD_DEMO_MESSAGE_COUNT}] {body}",
            f"{GROUP_ALIAS_LOCALPART}-unread-{run_id}-{index}",
        )
        if index % 10 == 0:
            print(
                "seed-matrix: unread demo progress "
                f"{index}/{UNREAD_DEMO_MESSAGE_COUNT}"
            )
    print(
        f"seed-matrix: added {UNREAD_DEMO_MESSAGE_COUNT} main-timeline messages "
        f"(Chromium: {chromium}, WebKit: {webkit}) to {room_id}."
    )


def thread_relations(token: str, room_id: str, root_id: str) -> list[dict[str, Any]]:
    return http_json(
        "GET",
        f"{HOMESERVER}/_matrix/client/v1/rooms/{room_id}/relations/{root_id}/m.thread",
        token=token,
    ).get("chunk", [])


def ensure_thread(tokens: dict[str, str], room_id: str, root_id: str) -> None:
    existing = thread_relations(tokens["hub"], room_id, root_id)
    by_body = {
        event.get("content", {}).get("body"): event.get("event_id")
        for event in existing
    }
    first_author, first_body = THREAD_REPLIES[0]
    first_id = by_body.get(first_body)
    if not first_id:
        first_id = send_thread_reply(
            tokens[first_author],
            room_id,
            root_id,
            first_body,
            f"{GROUP_ALIAS_LOCALPART}-thread-0",
        )

    second_author, second_body = THREAD_REPLIES[1]
    if second_body not in by_body:
        # Establish a real threaded baseline before the second reply. This avoids
        # the SDK's legacy rule that treats threads predating the first threaded
        # receipt as already read, making first-unread reproducible on a fresh DB.
        send_thread_receipt(tokens["hub"], room_id, root_id, first_id)
        send_thread_reply(
            tokens[second_author],
            room_id,
            root_id,
            second_body,
            f"{GROUP_ALIAS_LOCALPART}-thread-1",
        )
        print(f"seed-matrix: seeded a 2-reply thread in {room_id}.")


def ensure_room(
    tokens: dict[str, str],
    owner: str,
    alias_localpart: str,
    name: str,
    invited: list[str],
    messages: list[tuple[str, str]],
    is_direct: bool = False,
) -> str:
    alias = f"#{alias_localpart}:{SERVER_NAME}"
    room_id = existing_room_id(tokens[owner], alias)
    if room_id:
        print(f"seed-matrix: room {alias} already exists ({room_id}).")
        # `join` is idempotent and also accepts a pending invitation for Hub.
        join_room(tokens[owner], room_id)
        for localpart in invited:
            ensure_room_participant(tokens, owner, localpart, room_id)
        return room_id

    print(f"seed-matrix: creating unencrypted room {alias}...")
    room_id = create_room(tokens[owner], alias_localpart, name, invited, is_direct)
    for localpart in invited:
        join_room(tokens[localpart], room_id)
    for index, (author, body) in enumerate(messages):
        send_message(tokens[author], room_id, body, f"{alias_localpart}-{index}")
    print(f"seed-matrix: seeded {len(messages)} messages in {room_id}.")
    return room_id


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--users-only",
        action="store_true",
        help="provision linked Matrix users without creating rooms or messages",
    )
    mode.add_argument(
        "--unread-demo",
        action="store_true",
        help="append 30 Chromium and 30 WebKit main-timeline messages",
    )
    return parser.parse_args()


def main(*, users_only: bool = False, unread_demo: bool = False) -> None:
    print("seed-matrix: provisioning identities...")
    admin_token = keycloak_admin_token()
    tokens = {
        localpart: provision_linked_user(admin_token, localpart, display)
        for localpart, display in LINKED_USERS
    }

    if users_only:
        print("seed-matrix: Done (users only; no rooms created).")
        return

    ensure_room(
        tokens,
        "hub",
        DIRECT_ALIAS_LOCALPART,
        "",
        ["user-e2e-webkit"],
        DIRECT_MESSAGES,
        is_direct=True,
    )
    group_room_id = ensure_room(
        tokens,
        "hub",
        GROUP_ALIAS_LOCALPART,
        GROUP_NAME,
        ["user-e2e-chromium", "user-e2e-webkit"],
        GROUP_MESSAGES,
    )
    root_id = find_message_id_by_body(
        tokens["hub"],
        group_room_id,
        GROUP_MESSAGES[THREAD_ROOT_INDEX][1],
    )
    if not root_id:
        fail("could not find the seeded group message used as thread root.")
    ensure_thread(tokens, group_room_id, root_id)
    if unread_demo:
        seed_unread_demo(tokens, group_room_id)
    print("seed-matrix: Done.")


if __name__ == "__main__":
    arguments = parse_args()
    main(
        users_only=arguments.users_only,
        unread_demo=arguments.unread_demo,
    )
