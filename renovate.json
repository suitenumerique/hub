{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>suitenumerique/ci//renovate/default"],
  "dependencyDashboard": {
    "enabled": true
  },
  "labels": ["dependencies", "noChangeLog", "automated"],
  "enabledManagers": ["github-actions", "npm", "pep621", "dockerfile", "docker-compose"],
  "prConcurrentLimit": 6,
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "allowed postgres versions",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "<16"
    },
    {
      "groupName": "allowed python versions",
      "matchManagers": ["pep621", "github-actions", "dockerfile", "docker-compose"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "groupName": "allowed keydb versions",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose"],
      "matchPackageNames": ["eqalpha/keydb"],
      "allowedVersions": "<7"
    },
    {
      "groupName": "allowed redis versions",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["redis"],
      "allowedVersions": "<6.0.0"
    },
    {
      "groupName": "allowed celery versions",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["celery"],
      "allowedVersions": "<5.7.0"
    },
    {
      "enabled": false,
      "groupName": "ignored python dependencies",
      "matchManagers": ["pep621"],
      "matchPackageNames": []
    },
    {
      "groupName": "allowed node versions",
      "matchManagers": ["npm", "github-actions", "dockerfile", "docker-compose"],
      "matchPackageNames": ["node"],
      "allowedVersions": "<23"
    },
    {
      "enabled": false,
      "groupName": "ignored js dependencies",
      "matchManagers": ["npm"],
      "matchPackageNames": []
    }
  ]
}
