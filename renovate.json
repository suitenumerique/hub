{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>suitenumerique/ci//renovate/default"],
  "dependencyDashboard": {
    "enabled": true
  },
  "labels": ["dependencies", "noChangeLog", "automated"],
  "enabledManagers": ["github-actions", "npm", "pep621", "dockerfile", "docker-compose"],
  "prConcurrentLimit": 6,
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "allowed python versions",
      "matchManagers": ["pep621", "dockerfile", "docker-compose"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "enabled": false,
      "groupName": "ignored python dependencies",
      "matchManagers": ["pep621"],
      "matchPackageNames": []
    },
    {
      "groupName": "allowed redis versions",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["redis"],
      "allowedVersions": "<6.0.0"
    },
    {
      "groupName": "allowed pylint versions",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["pylint"],
      "allowedVersions": "<4.0.0"
    },
    {
      "groupName": "allowed django versions",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["django"],
      "allowedVersions": "<6.0.0"
    },
    {
      "groupName": "allowed celery versions",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["celery"],
      "allowedVersions": "<5.6.0"
    },
    {
      "enabled": false,
      "groupName": "ignored js dependencies",
      "matchManagers": ["npm"],
      "matchPackageNames": []
    }
  ]
}
