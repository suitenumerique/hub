{
  "name": "app-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs && node scripts/copy-emoji-assets.mjs",
    "dev": "next dev -p 9800",
    "prebuild": "node scripts/copy-pdf-assets.mjs && node scripts/copy-emoji-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build-theme": "cunningham -g css,scss,ts -o src/styles && mv src/styles/cunningham-tokens.scss src/styles/cunningham-tokens-sass.scss",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@gouvfr-lasuite/ui-components": "1.5.0",
    "@lobehub/fluent-emoji-flat": "1.1.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "@tanstack/react-query": "5.107.1",
    "clsx": "2.1.1",
    "commonmark": "0.31.2",
    "emojibase-data": "18.0.0",
    "frimousse": "0.4.0",
    "i18next": "27.1.2",
    "i18next-browser-languagedetector": "8.3.0",
    "linkifyjs": "4.4.0",
    "matrix-encrypt-attachment": "1.0.3",
    "matrix-js-sdk": "42.4.0",
    "next": "16.4.6",
    "posthog-js": "1.450.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-toastify": "11.2.0",
    "react-virtuoso": "4.18.23",
    "sass": "1.108.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/commonmark": "0.27.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "deepmerge": "4.3.1",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
