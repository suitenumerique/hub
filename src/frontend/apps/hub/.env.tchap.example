# Tchap connection settings for `make run-tchap`.
# `make tchap-env` copies this file to .env.tchap.local (git-ignored): edit
# that copy, never commit your email.

# tchap-preprod or tchap-prod (prod only with an authorised account). Read by
# the backend in Tchap mode.
FRONTEND_CHAT_ENVIRONMENT=tchap-preprod

# Email of your Tchap account. It finds your homeserver and pre-fills the
# Tchap sign-in page (local Keycloak users have no Tchap account).
NEXT_PUBLIC_MATRIX_LOGIN_HINT=
